{
  "manifest_version": 3,
  "name": "HF Convo Anywhere",
  "short_name": "Convo Anywhere",
  "version": "1.0.0",
  "description": "Chat in Hack Forums' Convo from any page: DMs, group chats and the global chat in a Messenger-style dock.",
  "homepage_url": "https://github.com/xadamxk/HF-Convo-Anywhere",
  "incognito": "spanning",
  "content_scripts": [
    {
      "run_at": "document_idle",
      "matches": [
        "https://hackforums.net/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "action": {
    "default_title": "HF Convo Anywhere",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage"
  ]
}
