{
  "name": "hf-convo-anywhere",
  "version": "1.0.1",
  "description": "Chat in Hack Forums' Convo from any page, a native browser extension.",
  "private": true,
  "scripts": {
    "dev": "webpack --config=config/webpack.dev.ts",
    "build": "webpack --config=config/webpack.prod.ts",
    "package": "npm run build && node scripts/package.js",
    "icons": "node scripts/make-icons.js",
    "banners": "node scripts/make-banners.js",
    "banners:png": "node scripts/render-banners.js && node scripts/render-banners.js assets/signatures",
    "buttons": "node scripts/make-buttons.js",
    "buttons:png": "node scripts/render-banners.js assets/buttons --transparent",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.jest.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "author": "xadamxk",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chrome": "^0.0.332",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.9",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.112.0",
    "webpack-cli": "^5.1.4",
    "webpack-merge": "^5.9.0"
  }
}
